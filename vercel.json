{
  "framework": "nextjs",
  "installCommand": "npm i -g pnpm@9.15.4 && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @estlem/shared build && NODE_OPTIONS=--experimental-fetch pnpm --filter @estlem/web build",
  "outputDirectory": "apps/web/.next",
  "env": {
    "NODE_OPTIONS": "--experimental-fetch"
  }
}
